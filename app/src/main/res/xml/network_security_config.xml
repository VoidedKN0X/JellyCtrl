<?xml version="1.0" encoding="utf-8"?>
<!-- The server address is typed in by the user and many Jellyfin servers run on plain HTTP on the
     home network, so cleartext can't be limited to fixed domains here. Instead the app enforces it:
     https is always tried first, http is only used after the user explicitly confirms it for that
     server (no silent downgrade), credentials are never sent over http to any other host
     (ServerAuthInterceptor), and http accounts carry a "Not encrypted (HTTP)" badge.
     User-installed CAs stay trusted so servers behind a private CA / self-signed reverse proxy work. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
